# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Ansible vault
deploy/ansible/vars/*.vault
deploy/ansible/.vault_pass
*.vault
.vault_pass

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.j2

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite database (the file *is* the data — never commit it)
prisma/*.db
prisma/*.db-journal
