generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per "service category" landing page (generalnaya-uborka,
// uborka-ofisov, ...). Rendered by the dynamic app/[slug]/page.tsx route —
// team/FAQ/SEO-text/consultation-CTA copy is shared boilerplate and stays
// in lib/serviceCategoryContent.ts, this model only holds what actually
// varies per page.
model ServicePage {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  title                   String
  heroDescription         String   @default("Доступны 24/7 — уборка тогда, когда это нужно Вам! Все клининговые услуги в одном месте.")
  heroImageUrl            String?
  consultationImageUrl    String?
  breadcrumbCategoryLabel String
  breadcrumbCategoryHref  String
  showFeaturesBlock       Boolean  @default(true)
  // SQLite has no scalar-list type, so this is JSON holding a string array.
  featureTags             Json     @default("[]")
  showProcessSteps        Boolean  @default(false)
  showMidBanner           Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Shared staff roster shown on every service page's "Наша команда" section.
// One table instead of duplicating the same 4 people per row.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// role values: "ADMIN" | "USER" | "BANNED" (see lib/roles.ts). Sign-in is
// rejected for banned users (see lib/auth.ts's authorize()) — this only
// blocks future logins, it doesn't revoke an already-issued JWT session
// (this app uses stateless sessions, not DB-backed ones). String, not an
// enum, because the SQLite provider has no native enum type.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password-recovery OTP — shown directly to the user in a toast rather
  // than emailed (no email provider configured), so this is a demo-grade
  // mechanism, not a secure one. Hashed anyway for defense in depth.
  resetOtpHash      String?
  resetOtpExpiresAt DateTime?

  // Personal-account profile fields — editable by the user on /profile.
  // Email is deliberately not here: it's the login identifier and isn't
  // user-editable (see components/profile/ProfileEditor.tsx).
  name    String?
  phone   String?
  address String?
  orders  Order[]
  chats   Chat[]

  // Admin-only Telegram notification linking (lib/telegramBot.ts's /start
  // <token> handler). telegramLinkToken is a one-time value generated by
  // /profile's "Подключить Telegram" action and cleared once the bot
  // confirms the link by setting telegramChatId.
  telegramChatId    String? @unique
  telegramLinkToken String? @unique
}

// A cleaning order shown on the customer's /profile page. Status and the
// 4-step timeline are derived (lib/orderStatus.ts) from which of the
// timestamps below are set, rather than stored redundantly as an enum —
// canceledAt always wins and is terminal.
model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "GENERAL" | "WINDOWS" | "RENOVATION" | "SUPPORT" | "STANDARD" | "DEATH"
  // | "FLOOD" | "FIRE" (see lib/orderKind.ts). String, not enum — SQLite.
  kind          String
  title         String
  date          DateTime
  address       String
  price         Int
  serviceDetail String
  staff         String
  payment       String

  acceptedAt  DateTime  @default(now())
  assignedAt  DateTime?
  completedAt DateTime?
  paidAt      DateTime?
  canceledAt  DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatMessages ChatMessage[]
}

// Generic image-slot metadata, keyed by a stable string id (e.g.
// "svc-windows", "staff-1", "why-us-reason1"). The actual bytes live in
// S3-compatible object storage under images/<key> (see lib/imageStorage.ts);
// this row only carries mimeType + updatedAt for URL cache-busting.
model SiteImage {
  key       String   @id
  mimeType  String
  updatedAt DateTime @updatedAt
}

// Homepage "Наши акции" marquee cards.
model Promo {
  id        String   @id @default(cuid())
  badge     String
  title     String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Homepage "Наши услуги" section blocks (components/landing/ServicesDetail.tsx).
// slotId is the SiteImage key for this block's photo — kept separate from
// this row's own id so existing uploaded photos aren't orphaned by editing
// title/items.
model ServiceBlock {
  id     String @id @default(cuid())
  // "BIG" | "SMALL". String, not enum — SQLite.
  size   String
  title  String
  slotId String @unique
  // JSON string array (SQLite has no scalar-list type).
  columns   Int      @default(1)
  items     Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per selectable option in the homepage cost calculator
// (components/landing/CalculatorDetailed.tsx). `value`'s meaning depends on
// `field` and is interpreted in lib/calculator.ts — multiplier for
// OBJECT_TYPE/DIRT/BUILDING_TYPE/REGION/URGENCY, divider for STAFF, flat
// ruble price for EXTRA. `key` is the stable id referenced by Calc2State.
model CalculatorOption {
  id String @id @default(cuid())
  // "OBJECT_TYPE" | "DIRT" | "BUILDING_TYPE" | "REGION" | "URGENCY" | "STAFF"
  // | "EXTRA" (see lib/calculatorFields.ts). String, not enum — SQLite.
  field String
  key   String
  label String
  value Float
  // isFixed=false: value is a price multiplier (default). isFixed=true: value
  // is a flat ruble amount added to the total when this option is selected.
  isFixed   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([field, key])
}

// Homepage "Отзывы" cards — admin-authored site content, not real customer
// submissions (this project never fabricates fake testimonials; an admin
// explicitly writes these themselves, same spirit as the placeholder text
// they replace).
model Review {
  id        String   @id @default(cuid())
  stars     Int      @default(5)
  text      String
  service   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Homepage "Примеры работ" before/after blocks (components/landing/Gallery.tsx).
// Admin adds/removes blocks; before/after photos are uploaded to S3 and their
// URLs stored here (same pattern as ServicePage images). meta is a JSON string
// array of small chips ("⏱ Сроки: 2 часа", ...).
model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  meta      Json
  beforeUrl String?
  afterUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One real support chat and one demo/latency-test chat per user, lazily
// created on first visit (see lib/chat.ts's getOrCreateChat) — the unique
// constraint below is what makes "at most one of each per user" hold
// without needing a separate chat-picker UI.
model Chat {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@unique([userId, isDemo])
}

// kind ORDER messages are posted by lib/orderCreation.ts when a customer
// submits the in-chat calculator (components/chat/ChatOrderCalculator.tsx) —
// text holds a short fallback label, orderId is the actual order to render
// as a preview card (components/chat/OrderPreviewCard.tsx). SetNull (not
// Cascade) so deleting the order from /admin/orders doesn't erase the chat
// message, it just renders a "Заказ удалён" fallback.
model ChatMessage {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // sender: "USER" | "ADMIN" | "BOT"; kind: "TEXT" | "ORDER" | "FILE".
  // String, not enum — SQLite (see lib/dbEnums.ts).
  sender String
  kind   String  @default("TEXT")
  text   String
  // kind FILE: an uploaded attachment. Bytes live in S3 under
  // chat/<chatId>/<attachmentKey> (see lib/chatAttachments.ts); type is the
  // mime, name the original filename shown as a download label.
  attachmentKey  String?
  attachmentName String?
  attachmentType String?
  orderId        String?
  order          Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  readByUser     Boolean @default(false)
  readByAdmin    Boolean @default(false)
  createdAt   DateTime @default(now())
}

// "Заказать звонок" requests — from the homepage ContactModal (source
// "site") and from the Telegram bot's own "Оставить заявку на звонок" flow
// (source "telegram", telegramChatId set so admin can reply there too).
model CallbackRequest {
  id              String    @id @default(cuid())
  phone           String
  source          String
  telegramChatId  String?
  handledAt       DateTime?
  createdAt       DateTime  @default(now())
}

// "О компании" page content (app/o-kompanii), admin-editable at
// /admin/about. Singleton row (id "about"). stats/values are Json arrays of
// {value,label} / {title,text} so the admin can add or remove items freely.
model AboutPage {
  id           String   @id @default("about")
  eyebrow      String
  heading      String
  lead         String
  stats        Json
  missionTitle String
  missionText1 String
  missionText2 String
  values       Json
  ctaTitle     String
  ctaText      String
  updatedAt    DateTime @updatedAt
}

// Homepage "Цены на клининг" price table (components/landing/Pricing.tsx).
// tab is one of lib/content.ts's static PriceTabId values ("flats" |
// "houses" | "rooms" | "special" | "windows") — the tab categories
// themselves stay a fixed structural list, only the rows are admin-editable.
model PriceRow {
  id        String   @id @default(cuid())
  tab       String
  name      String
  price     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pending email-verification for public registration. Holds the hashed OTP and
// the would-be user's hashed password until the code is confirmed; on success
// a real User row is created and this row is deleted. Unverified emails never
// become User rows.
model EmailVerification {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
