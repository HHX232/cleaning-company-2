generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per "service category" landing page (generalnaya-uborka,
// uborka-ofisov, ...). Rendered by the dynamic app/[slug]/page.tsx route —
// team/FAQ/SEO-text/consultation-CTA copy is shared boilerplate and stays
// in lib/serviceCategoryContent.ts, this model only holds what actually
// varies per page.
model ServicePage {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  title                   String
  heroDescription         String   @default("Доступны 24/7 — уборка тогда, когда это нужно Вам! Все клининговые услуги в одном месте.")
  heroImageUrl            String?
  consultationImageUrl    String?
  breadcrumbCategoryLabel String
  breadcrumbCategoryHref  String
  showFeaturesBlock       Boolean  @default(true)
  // SQLite has no scalar-list type, so this is JSON holding a string array.
  featureTags             Json     @default("[]")
  showProcessSteps        Boolean  @default(false)
  showMidBanner           Boolean  @default(false)
  // "Что такое / что входит" double info block (components/service-page/ServiceInfoBlocks.tsx).
  // Both optional — the block hides itself until an admin fills them in.
  // aboutText is a plain paragraph; includesText is one checklist line per
  // newline, same convention as featureTags above.
  aboutText               String?
  includesText            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Shared staff roster shown on every service page's "Наша команда" section.
// One table instead of duplicating the same 4 people per row.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  photoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A cleaning order, identified by the guest's phone number — no account
// involved. Status and the 4-step timeline are derived (lib/orderStatus.ts)
// from which of the timestamps below are set, rather than stored
// redundantly as an enum — canceledAt always wins and is terminal.
model Order {
  id    String @id @default(cuid())
  phone String

  // "GENERAL" | "WINDOWS" | "RENOVATION" | "SUPPORT" | "STANDARD" | "DEATH"
  // | "FLOOD" | "FIRE" (see lib/orderKind.ts). String, not enum — SQLite.
  kind          String
  title         String
  date          DateTime
  address       String?
  price         Int
  serviceDetail String
  staff         String
  payment       String

  acceptedAt  DateTime  @default(now())
  assignedAt  DateTime?
  completedAt DateTime?
  paidAt      DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-guest-phone Telegram opt-in for order-status notifications — phone is
// the only identity, no account involved. Upserted when a customer clicks
// "Подключить Telegram" after submitting an order; linkToken clears once the
// bot confirms the link via /start cust:<token>.
model PhoneTelegramLink {
  phone     String   @id
  chatId    String?  @unique
  linkToken String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row (id always "admin") for the one hardcoded admin's own
// Telegram link — new-order/callback alerts. Mirrors AboutPage's singleton
// pattern below.
model AdminSettings {
  id                String   @id @default("admin")
  telegramChatId    String?  @unique
  telegramLinkToken String?  @unique
  updatedAt         DateTime @updatedAt
}

// Generic image-slot metadata, keyed by a stable string id (e.g.
// "svc-windows", "staff-1", "why-us-reason1"). The actual bytes live in
// S3-compatible object storage under images/<key> (see lib/imageStorage.ts);
// this row only carries mimeType + updatedAt for URL cache-busting.
model SiteImage {
  key       String   @id
  mimeType  String
  updatedAt DateTime @updatedAt
}

// Homepage "Наши акции" marquee cards.
model Promo {
  id        String   @id @default(cuid())
  badge     String
  title     String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Homepage "Наши услуги" section blocks (components/landing/ServicesDetail.tsx).
// slotId is the SiteImage key for this block's photo — kept separate from
// this row's own id so existing uploaded photos aren't orphaned by editing
// title/items.
model ServiceBlock {
  id     String @id @default(cuid())
  // "BIG" | "SMALL". String, not enum — SQLite.
  size   String
  title  String
  slotId String @unique
  // JSON string array (SQLite has no scalar-list type).
  columns   Int      @default(1)
  items     Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per selectable option in the homepage cost calculator
// (components/landing/CalculatorDetailed.tsx). `value`'s meaning depends on
// `field` and is interpreted in lib/calculator.ts — multiplier for
// OBJECT_TYPE/DIRT/BUILDING_TYPE/REGION/URGENCY, divider for STAFF, flat
// ruble price for EXTRA. `key` is the stable id referenced by Calc2State.
model CalculatorOption {
  id String @id @default(cuid())
  // "OBJECT_TYPE" | "DIRT" | "BUILDING_TYPE" | "REGION" | "URGENCY" | "STAFF"
  // | "EXTRA" (see lib/calculatorFields.ts). String, not enum — SQLite.
  field String
  key   String
  label String
  value Float
  // isFixed=false: value is a price multiplier (default). isFixed=true: value
  // is a flat ruble amount added to the total when this option is selected.
  isFixed   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([field, key])
}

// Homepage "Отзывы" cards — admin-authored site content, not real customer
// submissions (this project never fabricates fake testimonials; an admin
// explicitly writes these themselves, same spirit as the placeholder text
// they replace).
model Review {
  id        String   @id @default(cuid())
  stars     Int      @default(5)
  text      String
  service   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// "Примеры работ" before/after blocks (components/landing/Gallery.tsx), shown
// on the homepage and every service page. Admin adds/removes blocks;
// before/after photos are uploaded to S3 and their URLs stored here (same
// pattern as ServicePage images). meta is a JSON string array of small chips
// ("⏱ Сроки: 2 часа", ...). category picks which pages a block appears on:
// "windows" blocks show only on "Мойка окон" service pages, "general" blocks
// show everywhere else (including the homepage).
model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  meta      Json
  category  String   @default("general")
  beforeUrl String?
  afterUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// "Заказать звонок" requests — from the homepage ContactModal (source
// "site") and from the Telegram bot's own "Оставить заявку на звонок" flow
// (source "telegram", telegramChatId set so admin can reply there too).
model CallbackRequest {
  id              String    @id @default(cuid())
  phone           String
  source          String
  telegramChatId  String?
  handledAt       DateTime?
  createdAt       DateTime  @default(now())
}

// "О компании" page content (app/o-kompanii), admin-editable at
// /admin/about. Singleton row (id "about"). stats/values are Json arrays of
// {value,label} / {title,text} so the admin can add or remove items freely.
model AboutPage {
  id           String   @id @default("about")
  eyebrow      String
  heading      String
  lead         String
  stats        Json
  missionTitle String
  missionText1 String
  missionText2 String
  values       Json
  ctaTitle     String
  ctaText      String
  updatedAt    DateTime @updatedAt
}

// Homepage "Цены на клининг" price table (components/landing/Pricing.tsx).
// tab is one of lib/content.ts's static PriceTabId values ("flats" |
// "houses" | "rooms" | "special" | "windows") — the tab categories
// themselves stay a fixed structural list, only the rows are admin-editable.
model PriceRow {
  id        String   @id @default(cuid())
  tab       String
  name      String
  price     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Homepage hero banner (components/landing/Hero.tsx) plus the "Причины
// заказать уборку" carousel (components/landing/WhyUs.tsx) — the carousel's
// photos stay tied to the fixed SiteImage keys "why-us-reason1".."5"
// (lib/homeImageSlots.ts), only its copy lives here as `reasons` (JSON array
// of {tag,title,text}, same 5-item order as the image slots). Also covers
// the rest of the homepage's own static sections: "Простой и понятный
// процесс" timeline, "Уборка с понятными условиями" benefits, the bottom
// CTA banner, and the homepage FAQ (also used for the page's FAQ JSON-LD).
// Singleton row (id "home"). Admin-editable at /admin.
model HomeContent {
  id                 String   @id @default("home")
  heroEyebrow        String
  heroTitleMain      String
  heroTitleHighlight String
  heroTitleSuffix    String
  heroSubtitle       String
  heroCtaPrimary     String
  heroCtaSecondary   String
  // JSON string array of service badge labels.
  heroServices Json
  // JSON array of {value,label}.
  heroStats    Json
  // JSON array of {tag,title,text}, fixed length 5.
  reasons      Json
  reasonsSectionTitle String

  specialistsTitle String
  calculatorTitle  String
  reviewsTitle     String
  galleryTitle     String
  promotionsTitle  String
  servicesTitle    String
  pricesTitle      String

  howItWorksTitle String
  howItWorksLead  String
  // JSON array of {icon,title,text} — "Простой и понятный процесс" timeline.
  howItWorks Json

  serviceGuaranteesTitle String
  // JSON array of {icon,title,text} — "Уборка с понятными условиями" block.
  serviceGuarantees Json

  faqSectionTitle String
  // JSON array of {question,answer} — homepage FAQ + its JSON-LD.
  faqItems Json

  ctaBannerTitle   String
  ctaBannerCtaLabel String
  // JSON string array of paragraphs shown in the homepage CTA banner.
  ctaBannerParagraphs Json

  updatedAt DateTime @updatedAt
}

// The 5 fixed service-category hub pages (uborka-kvartir, uborka-domov,
// uborka-kommercheskih-pomeshhenij, speczuborka, mojka-okon), each rendered
// by components/service-page/ServiceCategoryHub.tsx. Rows are fixed by
// `slug` (matches the route folder) — admin edits existing rows, doesn't
// add/remove them. Admin-editable at /admin/service-categories.
model ServiceCategoryPage {
  id      String @id @default(cuid())
  slug    String @unique
  href    String
  label   String
  title   String
  eyebrow String
  lead    String
  order   Int    @default(0)

  updatedAt DateTime @updatedAt
}

// Shared boilerplate on every ServiceCategoryPage hub page (the "Выберите
// услугу" list section and the bottom CTA) — singleton row (id
// "service-hub"). Admin-editable at /admin/service-categories.
model ServiceHubShared {
  id           String @id @default("service-hub")
  sectionTitle String
  emptyText    String
  ctaTitle     String
  ctaText      String

  updatedAt DateTime @updatedAt
}

// Shared boilerplate rendered on every individual service page
// (app/[slug]/page.tsx via components/service-page/ServiceCategoryPage.tsx)
// — team/FAQ/SEO-text/consultation-CTA/process-steps/mid-banner copy that's
// identical across all ~65 pages, only what varies per page lives on
// ServicePage itself. Singleton row (id "service-shared"). The mid-banner
// staff photo stays a SiteImage slot ("svc-mid-banner-staff"), not a field
// here. Admin-editable at /admin/service-shared.
model ServiceSharedContent {
  id String @id @default("service-shared")

  heroCtaLabel String

  // JSON array of {num,title,text}, fixed length 4 — components/service-page/ProcessSteps.tsx.
  processSteps Json

  // components/service-page/MidPageCta.tsx.
  midBannerStaffName String
  // JSON string array of role labels.
  midBannerStaffRoles Json
  midBannerTitle      String
  // JSON string array of paragraphs.
  midBannerParagraphs Json
  midBannerCtaLabel   String

  howToOrderTitle     String
  howToOrderIntro     String
  howToOrderOutroLead String
  howToOrderOutroBold String
  howToOrderOutroTail String

  teamTitle     String
  teamSubtitle1 String
  teamSubtitle2 String

  calculatorTitle String
  reviewsTitle    String
  galleryTitle    String

  // JSON array of {question,answer}, shown as the service page's own FAQ.
  serviceFaq Json
  // JSON string array of SEO paragraphs shown under "Читать полностью".
  seoText Json

  // components/service-page/ConsultationCta.tsx.
  consultationEyebrow  String
  consultationTitle    String
  consultationSubtitle String
  // JSON string array of bullet perks.
  consultationPerks    Json
  consultationCtaLabel String

  updatedAt DateTime @updatedAt
}

// "Наши гарантии" page (app/nashi-garantii). Singleton row (id
// "guarantees"). items is a JSON array of {title,text} cards.
// Admin-editable at /admin/guarantees.
model GuaranteesPage {
  id       String @id @default("guarantees")
  eyebrow  String
  heading  String
  lead     String
  items    Json
  ctaTitle String
  ctaText  String

  updatedAt DateTime @updatedAt
}

// "Почему выбирают нас" 8-reason grid (components/landing/WhyChooseUs.tsx),
// shown on the homepage and its own page (app/pochemu-vybirayut-nas).
// Singleton row (id "why-us"). advantages is a JSON array of
// {icon,title,text}. Admin-editable at /admin/why-us.
model WhyUsPage {
  id          String @id @default("why-us")
  eyebrow     String
  title       String
  description String
  advantages  Json

  updatedAt DateTime @updatedAt
}

// "Контакты" page (app/contacts). Singleton row (id "contacts"). Phone/email
// values themselves stay in lib/content.ts's `company` config (used
// site-wide in Header/Footer/SEO), only this page's own copy lives here.
// Admin-editable at /admin/contacts.
model ContactsPage {
  id                String @id @default("contacts")
  eyebrow           String
  heading           String
  lead              String
  hoursValue        String
  hoursText         String
  areaText          String
  phoneNote         String
  emailNote         String
  messengersHeading String
  ctaTitle          String
  ctaText           String

  updatedAt DateTime @updatedAt
}

// Privacy policy (app/privacy) and terms of service (app/terms) — id is
// "privacy" or "terms". sectionsText holds "### Title" headed blocks
// (lib/legalData.ts parses on the "### " marker), so an admin can add or
// remove sections just by editing lines, same convention as the pipe-joined
// lists elsewhere. Admin-editable at /admin/legal.
model LegalPage {
  id            String @id
  heading       String
  effectiveDate String
  sectionsText  String

  updatedAt DateTime @updatedAt
}
