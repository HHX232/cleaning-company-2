server {
	server_name {{ nginx_domain }} www.{{ nginx_domain }};
	charset off;
	index index.php index.html;
	disable_symlinks if_not_owner from=$root_path;
	include /etc/nginx/vhosts-includes/*.conf;
	include {{ nginx_resources_path }}/*.conf;
	include /etc/nginx/users-resources/www-root/*.conf;
	access_log {{ access_log }};
	error_log {{ error_log }} notice;
	set $root_path {{ app_dir }};
	root $root_path;
	listen 87.232.67.175:80;
	gzip on;
	gzip_comp_level 5;
	gzip_disable "msie6";
	gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/javascript image/svg+xml;

	location / {
		location ~* ^.+\.(jpg|jpeg|gif|png|svg|js|css|mp3|ogg|mpe?g|avi|zip|gz|bz2?|rar|swf|webp|woff|woff2)$ {
			expires 24h;
			try_files $uri $uri/ @fallback;
		}
		location / {
			try_files /does_not_exists @fallback;
		}
	}

	location @fallback {
		include {{ nginx_resources_path }}/dynamic/*.conf;
		proxy_pass http://127.0.0.1:{{ pm2_port }};
		proxy_redirect http://127.0.0.1:{{ pm2_port }} /;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Port $server_port;
		access_log off;
	}
}

