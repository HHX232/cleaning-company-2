server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    return 403;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name }} www.{{ domain_name }};

    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain_name }} www.{{ domain_name }};

    ssl_certificate /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # /_next/static/* — файлы всегда содержат content-hash в имени,
    # поэтому их можно кэшировать агрессивно и "immutable": новый билд
    # генерирует новые имена файлов, а не перезаписывает старые "на месте" —
    # важно для избежания гонки между уже открытыми у пользователя вкладками
    # и новым деплоем (см. модель releases/current в role deploy).
    location /_next/static/ {
        alias {{ app_dir }}/current/.next/standalone/.next/static/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        # Явный 404 тут почти всегда значит: (а) деплой ещё идёт и current
        # временно не содержит нужного хэша (браузер держит старую HTML), либо
        # (б) шаг "Copy static assets to standalone" не выполнился на сборке.
        try_files $uri =404;
    }

    location /_next/image {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Небольшой таймаут на graceful reload PM2: пока новый процесс
        # поднимается (см. wait_ready/listen_timeout в ecosystem.config.js),
        # nginx не должен мгновенно отдавать 502.
        proxy_next_upstream error timeout;
        proxy_connect_timeout 3s;
    }
}
