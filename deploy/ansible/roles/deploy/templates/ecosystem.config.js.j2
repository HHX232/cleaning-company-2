// Генерируется Ansible — не редактировать руками на сервере.
module.exports = {
  apps: [
    {
      name: "cleaning",
      script: "server.js",
      cwd: "{{ release_path }}/.next/standalone",
      instances: {{ pm2_instances }},
      exec_mode: "{{ 'cluster' if pm2_instances | int > 1 else 'fork' }}",
      node_args: "--max-old-space-size=768",
      env: {
        PORT: "{{ app_port }}",
        HOSTNAME: "127.0.0.1",
        NODE_ENV: "production",
      },
      max_memory_restart: "600M",
      autorestart: true,
      // wait_ready + listen_timeout дают PM2 понять, что новый процесс
      // реально поднялся и начал слушать порт, прежде чем убивать старый —
      // это то, что делает `pm2 reload` условно "zero-downtime" даже в fork-режиме.
      wait_ready: false,
      listen_timeout: 8000,
      kill_timeout: 5000,
    },
  ],
};
