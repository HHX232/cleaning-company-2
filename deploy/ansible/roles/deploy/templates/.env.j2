# DB
DATABASE_URL="file:{{ app_dir }}/prisma/dev.db"

# Auth — session cookie signing secret. ADMIN_PASSWORD_HASH is intentionally
# NOT an env var: every bcrypt hash starts with "$2b$10$...", and Next.js's
# built-in @next/env loader does $VAR expansion on .env files, silently
# corrupting any hash stored here. It's hardcoded in lib/auth.ts instead.
AUTH_SECRET="{{ AUTH_SECRET | default('') }}"
ADMIN_EMAIL="{{ ADMIN_EMAIL | default('') }}"

# Telegram Bot
TELEGRAM_BOT_TOKEN="{{ TELEGRAM_BOT_TOKEN | default('') }}"

# S3
S3_ENDPOINT="{{ S3_ENDPOINT | default('https://s3.kz-1.srvstorage.kz') }}"
S3_REGION="{{ S3_REGION | default('kz-1') }}"
S3_BUCKET="{{ S3_BUCKET | default('cleaning-company') }}"
S3_ACCESS_KEY="{{ S3_ACCESS_KEY | default('') }}"
S3_SECRET_KEY="{{ S3_SECRET_KEY | default('') }}"

# Mail
SMTP_HOST="{{ SMTP_HOST | default('smtp.hoster.by') }}"
SMTP_PORT="{{ SMTP_PORT | default('465') }}"
SMTP_USER="{{ SMTP_USER | default('noreply@специализированный-клининг.бел') }}"
SMTP_PASSWORD="{{ SMTP_PASSWORD | default('') }}"

# Misc
NODE_ENV="production"
